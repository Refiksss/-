<Window x:Class="Маусенбаев_Мусин.Regestracia"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Маусенбаев_Мусин"
        mc:Ignorable="d"
        Title="Regestracia" Height="436" Width="314" ResizeMode="NoResize">
    <Grid Background="#FFFBECF2">
        <Image Margin="75,216,-103,-36" Source="/i.png" Stretch="Fill" Opacity="0.52"/>
        <Image Margin="-42,0,86,185" Source="/f857fde033c2cd7b24a7a6db1782d165.png" Stretch="Fill" Opacity="0.52" RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="-1"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </Image.RenderTransform>
        </Image>
        <Button Content="Зарегыстрироваться" Click="Button_Click1" Margin="65,324,62,25" Background="#FFFFC8DE" BorderBrush="{x:Null}" FontFamily="Yu Gothic UI Light" Foreground="#FFFF66A3">
            <Button.Resources>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="CornerRadius" Value="10"/>
                </Style>
            </Button.Resources>
        </Button>
        <Button Content="Назад" Click="Button_Click" Margin="239,10,10,366" Background="#FFFFC8DE" BorderBrush="{x:Null}" FontFamily="Yu Gothic UI Light" Foreground="#FFFF66A3">
            <Button.Resources>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="CornerRadius" Value="10"/>
                </Style>
            </Button.Resources>
        </Button>
        <TextBox x:Name="LoginTextBox" HorizontalAlignment="Left" Margin="75,144,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="153" Height="29" BorderBrush="#FFFF8AB9"/>
        <TextBlock HorizontalAlignment="Left" Height="15" Margin="75,128,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="98" Foreground="#FFFF8AB9"><Run Language="ru-ru" Text="Создайте Логин"/></TextBlock>
        <TextBlock HorizontalAlignment="Left" Height="15" Margin="75,186,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="113" Foreground="#FFFF8AB9"><Run Language="ru-ru" Text="Придумай Пароль"/></TextBlock>
        <TextBlock HorizontalAlignment="Left" Height="14" Margin="75,247,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="62" Foreground="#FFFF8AB9"><Run Text="W "/><Run Language="ru-ru" Text="Пароль"/></TextBlock>
        <Label Content="Регыстрация" HorizontalAlignment="Left" Margin="158,59,0,0" VerticalAlignment="Top" FontSize="20" FontWeight="Bold" Foreground="#FFFF8AB9"/>
        <PasswordBox x:Name="PasswordBox2" HorizontalAlignment="Left" Margin="76,264,0,0" VerticalAlignment="Top" Width="151" Height="28" BorderBrush="#FFFF8AB9"/>
        <PasswordBox x:Name="PasswordBox" HorizontalAlignment="Left" Margin="75,202,0,0" VerticalAlignment="Top" Width="151" Height="29" BorderBrush="#FFFF8AB9"/>
    </Grid>
</Window>
